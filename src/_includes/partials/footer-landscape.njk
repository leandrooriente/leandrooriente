<svg class="footer-landscape-art" xmlns="http://www.w3.org/2000/svg" width="100%" height="426.6666667" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="footer-forest-first-half" clipPathUnits="userSpaceOnUse">
      <rect x="0" y="0" width="320" height="426.6666667"/>
    </clipPath>
    <clipPath id="footer-forest-second-half" clipPathUnits="userSpaceOnUse">
      <rect x="320" y="0" width="320" height="426.6666667"/>
    </clipPath>
    <!-- Mirror only the outer woodland, keeping the lookout in the center once. -->
    <pattern id="footer-forest-left" x="50%" y="0" width="640" height="426.6666667" patternUnits="userSpaceOnUse">
      <g clip-path="url(#footer-forest-first-half)">
        <image href="{{ footerArtworkUrl }}" x="0" y="0" width="1280" height="426.6666667"/>
      </g>
      <g clip-path="url(#footer-forest-second-half)">
        <image href="{{ footerArtworkUrl }}" x="0" y="0" width="1280" height="426.6666667" transform="translate(640 0) scale(-1 1)"/>
      </g>
    </pattern>
    <pattern id="footer-forest-right" x="50%" y="0" width="640" height="426.6666667" patternUnits="userSpaceOnUse">
      <g clip-path="url(#footer-forest-first-half)">
        <image href="{{ footerArtworkUrl }}" x="0" y="0" width="1280" height="426.6666667" transform="translate(1280 0) scale(-1 1)"/>
      </g>
      <g clip-path="url(#footer-forest-second-half)">
        <image href="{{ footerArtworkUrl }}" x="-640" y="0" width="1280" height="426.6666667"/>
      </g>
    </pattern>
  </defs>
  <rect x="0" y="0" width="50%" height="100%" fill="url(#footer-forest-left)" transform="translate(-640 0)"/>
  <image href="{{ footerArtworkUrl }}" x="50%" y="0" width="1280" height="426.6666667" transform="translate(-640 0)"/>
  <rect x="50%" y="0" width="50%" height="100%" fill="url(#footer-forest-right)" transform="translate(640 0)"/>
</svg>
