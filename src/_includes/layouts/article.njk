---
layout: layouts/base.njk
bodyClass: article-page
navigation: writing
---
<main class="shell article-shell" id="main" tabindex="-1">
  <article aria-labelledby="article-title">
    <header class="article-heading">
      <h1 class="article-title" id="article-title">{{ title }}</h1>
      <p class="article-deck">{{ deck }}</p>
      <p class="article-meta">By <a href="/" rel="author">{{ site.author.name }}</a> <span aria-hidden="true">—</span> {% if draft %}Draft{% elif publishedOn or publicationMonth %}Published in <time datetime="{{ publishedOn or publicationMonth }}">{{ (publishedOn or publicationMonth) | displayDate }}</time>{% else %}Published in <time datetime="{{ publicationYear }}">{{ publicationYear }}</time>{% endif %} <span aria-hidden="true">—</span> {{ content | readingMinutes(title, deck) }} minute read</p>
    </header>
    {% if illustration %}
    <figure class="article-illustration">
      {% responsiveImage illustration, illustrationAlt, "article", { loading: "eager", fetchpriority: "high" } %}
    </figure>
    {% endif %}
    <div class="article-reading">
      <div class="reading-body">
        {{ content | safe }}
      </div>
      <footer class="article-disclosure">
        <p>The views and opinions expressed in this article are my own. I do not speak on behalf of Shopify.</p>
      </footer>
    </div>
  </article>
</main>
<nav class="shell article-footer" aria-label="Article navigation">
  <a href="/writing/"><span aria-hidden="true">←</span> Back to writing</a>
</nav>
